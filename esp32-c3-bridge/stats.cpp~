
#include "stats.h"
#include <ArduinoJson.h>


static int last_minute = -1;
static stats_t stats;

static int get_minute(void)
{
    time_t now = time(nullptr);
    struct tm info;
    gmtime_r(&now, &info);
    return info.tm_min;
}

void stats_begin(void)
{
    memset(&stats.minute_counts, 0, sizeof(stats.minute_counts));
    stats.last_received = 0;
    last_minute = -1;
}

static void handleStatsRequest(AsyncWebServerRequest *request)
{
    AsyncResponseStream *response = request->beginResponseStream("application/json");

    StaticJsonDocument<1024> doc;
    doc["uptime"] = millis() / 1000;
    doc["lastReceived"] = stats.last_received;
    JsonArray counts = doc["minute_counts"].to<JsonArray>();
    for (int i = 0; i < 60; i++) {
        int min = (get_minute() + 60 - i) % 60;
        counts.add(stats.minute_counts[min]);
    }
    serializeJson(doc, *response);
    request->send(response);
}

void stats_serve(AsyncWebServer &server, const char *path)
{
    // register ourselves with the server
    server.on(path, HTTP_GET, handleStatsRequest);
}

void stats_count(int num)
{
    int minute = get_minute();
    stats.minute_counts[minute] += num;
}

// keeps stats updated even when no events happen, call this regularly, at least once per minute
void stats_update(void) {
    int minute = get_minute();
    if (minute != last_minute) {
        last_minute = minute;
        // restart count
        if (last_minute >= 0) {
            stats.minute_counts[minute] = 0;
        }
    }
}

